{
    "name": "serendipity_hq/bundle-features",
    "description": "Manage features and plans in your Symfony app.",
    "type": "symfony-bundle",
    "keywords": ["pricing", "plans", "paid", "features gating"],
    "homepage": "https://github.com/Aerendir/bundle-features",
    "license": "MIT",
    "authors": [
        {
            "name": "Adamo Aerendir Crespi",
            "email": "hello@aerendir.me"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "doctrine/common": "^3.0",
        "doctrine/doctrine-bundle": "^2.11 || ^3.0",
        "doctrine/orm": "^2.16 || ^3.0",
        "serendipity_hq/component-array-writer": "^6.0",
        "serendipity_hq/component-value-objects": "^7.1",
        "symfony/form": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/options-resolver": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/translation": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "ext-ast": "*",
        "bamarni/composer-bin-plugin": "^1.4",
        "phpstan/phpstan": "2.2.17",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "2.0.21",
        "phpstan/phpstan-symfony": "^2.0",
        "rector/rector": "2.6.7",
        "roave/security-advisories": "dev-master",
        "serendipity_hq/component-text-matrix": "^3.0",
        "serendipity_hq/rector-config": "1.1.20",
        "symfony/var-dumper": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\FeaturesBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\FeaturesBundle\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "bamarni/composer-bin-plugin": true
        }
    },
    "scripts": {
        "bin": "echo 'bin not installed'",
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false
        }
    }
}
